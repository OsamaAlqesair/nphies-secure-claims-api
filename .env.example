POSTGRES_DB=nphies
POSTGRES_USER=nphies
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nphies:replace-with-a-local-password@127.0.0.1:5432/nphies

# Generate a local 64-byte random SECRET_KEY; never commit the real .env.
SECRET_KEY=
JWT_ISSUER=nphies-claim-gate
JWT_AUDIENCE=nphies-api
ACCESS_TOKEN_MINUTES=15
